# ---------------------------------------------------------------------------
# Dunia configuration. Copy to .env and fill in. Real environment variables
# override this file.
# ---------------------------------------------------------------------------

# --- Deployment (docker-compose) ---
DOMAIN=chat.example.com          # your domain (Caddy gets HTTPS for it)
PUBLIC_IP=203.0.113.10           # the server's public IPv4 (for coturn)

# --- Server ---
PORT=3000
NODE_ENV=production
TRUST_PROXY=1                    # number of reverse proxies in front (Caddy=1, +Cloudflare=2)
# CORS_ORIGIN=https://chat.example.com

# --- Admin & monitoring ---
ADMIN_TOKEN=change-me-to-a-long-random-string   # enables /admin; generate: openssl rand -hex 32
# METRICS_PUBLIC=false          # true = /metrics without a token

# --- WebRTC (STUN/TURN) ---
# STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# TURN_URLS is set by docker-compose; set it yourself when not using compose:
# TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:5349
TURN_SECRET=change-me-too        # must equal coturn's static-auth-secret; generate: openssl rand -hex 32
# TURN_TTL_SEC=21600
# Or static credentials from a managed TURN provider (Cloudflare, Twilio, Metered…):
# TURN_USERNAME=
# TURN_CREDENTIAL=

# --- Matching ---
# REMATCH_COOLDOWN_SEC=120       # keep two people apart after they meet (0 in development)
# MATCH_SCAN_LIMIT=400           # max candidates examined per search
# MATCH_SWEEP_MS=1500            # how often waiting people are re-matched

# --- Location ---
# LOCK_COUNTRY_TO_IP=false       # true = country comes from the IP (anti-spoofing), not the user

# --- Safety ---
# MAX_CONN_PER_IP=20             # keep generous: many mobile users share one IP (CGNAT)
# BLOCK_CONTACT_SHARING=true     # hide links, phone numbers, e-mails and @handles in chat
# REPORT_SNAPSHOTS=true          # attach a still image of the reported video to reports
# AUTO_BAN_SCORE=4               # weighted distinct-reporter score that triggers a restriction
# AUTO_BAN_HOURS=24
# REPEAT_BAN_HOURS=168
# IP_BAN_HOURS=2                 # IP part of severe bans: short, new connections only (CGNAT-safe)
# DATA_DIR=./data

# --- Premium & payments ---
# Gender filter (Men / Women) needs Premium; everything else is free.
UPI_VPA=abirkumar111@ybl         # UPI ID that receives payments; any UPI app can pay it. Empty = UPI off
UPI_PAYEE_NAME=Dunia             # name shown in the UPI app (should match the account holder for trust)
# UPI_VERIFY=provisional         # provisional = Premium starts right after a valid UTR (max UPI_PROVISIONAL_MAX_MIN
#                                #   minutes) and the rest after you approve it in /admin; manual = nothing until approved
# UPI_PROVISIONAL_MAX_MIN=60
# PREMIUM_TRIAL_MIN=10           # one free trial per device (and at most 3 per IP per day)
# REFERRAL_REWARD_MIN=30         # minutes for BOTH people when an invited friend has their first real chat
# REWARD_DAY_OFFSET_MIN=330      # daily bonus resets at midnight in this UTC offset (330 = India)

# --- Google Play (Android app from the Play Store) ---
# PLAY_PACKAGE_NAME=app.dunia.chat
# PLAY_SERVICE_ACCOUNT_JSON=/secure/play-service-account.json   # path to the JSON key, or the JSON itself
# ANDROID_CERT_SHA256=AA:BB:…     # app signing key fingerprint(s) → /.well-known/assetlinks.json (invite links open the app)
# ANDROID_PACKAGES=app.dunia.chat,app.dunia.chat.direct
